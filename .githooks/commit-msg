#!/usr/bin/env bash
# commit-msg hook: enforce version-tagged commits for skills/hooks/templates
# Format: <type>(<scope>): <description> [v<version>]

msg=$(head -1 "$1")
pattern='^(feat|fix|refactor|docs)\((skills|hooks|memory|templates)\): .+ \[v[0-9]+\.[0-9]+\]$'

if [[ ! "$msg" =~ $pattern ]]; then
  echo "ERROR: commit message does not match required format:"
  echo ""
  echo "  <type>(<scope>): <description> [v<version>]"
  echo ""
  echo "  type:    feat | fix | refactor | docs"
  echo "  scope:   skills | hooks | memory | templates"
  echo "  version: e.g., v1.0, v2.1"
  echo ""
  echo "  Example: feat(skills): add brainstorm skill [v1.0]"
  echo ""
  echo "Your message: $msg"
  exit 1
fi
